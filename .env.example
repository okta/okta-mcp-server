# Okta Open Source MCP Server Environment Variables
# Copy this file to .env and fill in your values

# Required: Okta Organization URL (e.g., https://dev-123456.okta.com)
OKTA_ORG_URL=

# Required: OAuth Client ID from your Okta application
OKTA_CLIENT_ID=

# Required: API Scopes (space-separated, e.g., "okta.users.read okta.groups.manage")
OKTA_SCOPES=okta.users.read okta.groups.read

# Optional: For Private Key JWT authentication (browserless)
# Uncomment and set these if using Private Key JWT instead of Device Authorization
# OKTA_PRIVATE_KEY=
# OKTA_KEY_ID=

# Optional: Transport. "stdio" (default) or "streamable-http" (serves MCP at /mcp)
# OKTA_MCP_TRANSPORT=streamable-http
# OKTA_MCP_HOST=0.0.0.0
# OKTA_MCP_PORT=8000

# Optional: Per-user OAuth. "service" (default) or "user". In user mode every request must
# carry the caller's own Okta access token, so each caller can do only what their Okta admin
# role allows. Requires OKTA_MCP_TRANSPORT=streamable-http. OKTA_PRIVATE_KEY is not used.
# OKTA_AUTH_MODE=user
# OKTA_MCP_PUBLIC_URL=https://okta-mcp.example.com/mcp

# Optional: Logging configuration
# OKTA_LOG_LEVEL=DEBUG
# OKTA_LOG_FILE=/app/logs/okta-mcp.log

# Optional: Include the raw traceback tail in serializer-failure envelopes.
# Off by default so server-side stack frames are not exposed to MCP clients.
# Accepted truthy values: 1, true, yes, on (case-insensitive).
# OKTA_MCP_INCLUDE_RAW=1
