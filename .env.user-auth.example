# Okta MCP Server: per-user OAuth (OKTA_AUTH_MODE=user) for local testing
# Copy this file to .env.user-auth and fill in your values, then run:
#   uv run --env-file .env.user-auth okta-mcp-server
# Every caller signs in to Okta and acts with their own Okta admin role.

# Required: Okta Organization URL (e.g., https://dev-123456.okta.com)
OKTA_ORG_URL=

# Required: Client ID of the OIDC *Web* app (Authorization Code + Refresh Token).
# Tokens issued to any other app are rejected.
OKTA_CLIENT_ID=

# Optional: the same app's client secret, needed only to let the server refresh caller tokens
# for sessions that outlive the access token (send the refresh token in the
# X-Okta-Refresh-Token header). Okta honors a refresh_token grant only for the client the
# token was issued to, so the server cannot refresh anything without this secret. Leave it
# unset and the MCP client (Claude Code, LiteLLM) keeps refreshing on its own as before.
# OKTA_CLIENT_SECRET=

# Required: Okta API scopes granted to the web app (space-separated). Every token must
# carry openid plus all of these, and tools for scopes not listed here are hidden.
OKTA_SCOPES="okta.users.read okta.groups.read okta.groups.manage"

# User auth mode requires the HTTP transport. OKTA_PRIVATE_KEY / OKTA_KEY_ID are ignored.
OKTA_AUTH_MODE=user
OKTA_MCP_TRANSPORT=streamable-http
OKTA_MCP_HOST=127.0.0.1
OKTA_MCP_PORT=8000

# The URL MCP clients use to reach the server. It is advertised in the OAuth protected
# resource metadata at /.well-known/oauth-protected-resource/mcp.
# Under docker compose (host port 8003), use http://localhost:8003/mcp and OKTA_MCP_HOST=0.0.0.0.
OKTA_MCP_PUBLIC_URL=http://localhost:8000/mcp

# Requests are accepted only with a Host header of localhost or the OKTA_MCP_PUBLIC_URL host
# (what a reverse proxy like Caddy forwards). List any other host:port the server is reached by,
# space-separated; "10.0.0.5:*" allows any port.
# OKTA_MCP_ALLOWED_HOSTS=

# Optional: Logging configuration
OKTA_LOG_LEVEL=DEBUG
# OKTA_LOG_FILE=./logs/okta-mcp.log
